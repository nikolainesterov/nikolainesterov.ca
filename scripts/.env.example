# ═══════════════════════════════════════════════════════════
# R2 CREDENTIALS
# Copy this file to ".env" (same folder) and fill in your real
# values. Never commit the real ".env" file to git.
# ═══════════════════════════════════════════════════════════

# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
# (permissions: Object Read & Write, scoped to your bucket)
R2_ACCESS_KEY_ID=paste_your_access_key_id_here
R2_SECRET_ACCESS_KEY=paste_your_secret_access_key_here

# Cloudflare dashboard → R2 → Overview → your Account ID (top right area)
R2_ACCOUNT_ID=paste_your_account_id_here

# The name of the bucket you created
R2_BUCKET_NAME=nikolai-galleries
